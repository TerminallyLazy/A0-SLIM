{
  "name": "a0-slim",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "A local-first agent workspace built around libfx",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "node scripts/patch-libfx.cjs",
    "dev": "tsx src/cli.ts",
    "watch:ui": "vite build --watch",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.server.json && vite build && node scripts/ui-licenses.mjs",
    "start": "node dist/server/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.2",
    "@daytonaio/sdk": "0.226.1",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.7",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@vercel/sandbox": "3.9.0",
    "better-sqlite3": "13.0.3",
    "e2b": "2.59.0",
    "fastify": "5.12.7",
    "jose": "6.2.3",
    "libfx": "0.0.14",
    "modal": "0.11.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  },
  "bin": {
    "a0-slim": "bin/a0-slim.mjs"
  },
  "files": [
    "npm-shrinkwrap.json",
    "bin",
    "dist",
    "scripts/patch-libfx.cjs",
    "addons/local-embeddings/package.json",
    "addons/local-embeddings/npm-shrinkwrap.json",
    "addons/local-embeddings/worker.mjs",
    "docs/licenses",
    "docs/PACKAGING.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "addons/microsandbox/package.json",
    "addons/microsandbox/npm-shrinkwrap.json",
    "addons/microsandbox/worker.mjs",
    "addons/microsandbox/runtime.json",
    "LICENSE",
    "docs/MICROSANDBOX.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerminallyLazy/A0-SLIM.git"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "cbor-extract@2.2.2": true
  },
  "license": "MIT",
  "homepage": "https://github.com/TerminallyLazy/A0-SLIM#readme",
  "bugs": {
    "url": "https://github.com/TerminallyLazy/A0-SLIM/issues"
  },
  "keywords": [
    "agent-zero",
    "ai",
    "agent",
    "local-first",
    "mcp",
    "acp",
    "sandbox"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
