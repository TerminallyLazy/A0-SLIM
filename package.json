{
  "name": "a0-slim",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "A local-first agent workspace built around libfx",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "node scripts/patch-libfx.cjs",
    "dev": "tsx src/cli.ts",
    "watch:ui": "vite build --watch",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@daytonaio/sdk": "0.226.1",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.7",
    "@vercel/sandbox": "3.9.0",
    "better-sqlite3": "13.0.3",
    "e2b": "2.59.0",
    "fastify": "5.12.7",
    "jose": "6.2.3",
    "libfx": "0.0.14",
    "lucide-react": "1.61.0",
    "modal": "0.11.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
